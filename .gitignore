# ==========================================
# 🛡️ .gitignore - PowerFit System Security & Integrity
# ==========================================

# 🍎 OS generated files (macOS / Windows / Linux)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 🐍 Python environment & cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 🌐 Virtual Environments (venv / env / conda)
.venv/
venv/
ENV/
env/
.venv*/
api/.venv/

# 🧪 Testing & Coverage
.cache
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# 🛠️ IDEs & Editors settings
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# 🔐 Credentials, Keys & Environment Variables
.env
.env.*
*.pem
*.key
*.cert
*.crt

# 📦 Logs & Temp files
*.log
*.tmp
*.temp

