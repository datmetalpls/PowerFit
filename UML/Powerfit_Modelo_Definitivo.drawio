        <!-- ========================================== -->
        <!-- NOTAS EXPLICATIVAS Y DEFENSA DE DISEÑO     -->
        <!-- ========================================== -->
        <mxCell id="box_requisitos" parent="1" style="text;html=1;align=left;verticalAlign=top;fontStyle=0;fontColor=#1E8449;fontSize=11;strokeColor=#27AE60;fillColor=#E8F8F5;rounded=1;arcSize=6;spacingLeft=10;spacingTop=8;spacingRight=10;spacingBottom=8;whiteSpace=wrap;" value="&lt;b&gt;✅ SEIS REQUISITOS OFICIALES CUMPLIDOS CON RIGOR&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;Polimorfismo:&lt;/b&gt; Yoga, Spinning y Crossfit sobrescriben calcularCuposDisponibles() según sus recursos físicos (colchonetas, bicicletas, estaciones).&lt;br&gt;2. &lt;b&gt;Roles &amp; Permisos:&lt;/b&gt; Instructor (dicta y asiste), Recepcionista (inscribe y cobra) y Administrador (gestiona clases y stock).&lt;br&gt;3. &lt;b&gt;Validación Identidad:&lt;/b&gt; Persona.validarRut() con Algoritmo Módulo 11 + validaciones de teléfono y correo.&lt;br&gt;4. &lt;b&gt;Transacción Compuesta:&lt;/b&gt; InscripcionMensual (1) compone DetalleInscripcion (1..*) garantizando una reserva por clase y día.&lt;br&gt;5. &lt;b&gt;Reglas de Bloqueo:&lt;/b&gt; ClaseDirigida.hayCupo() (cupo físico lleno) y Socio.permitirIngreso() (membresía vencida).&lt;br&gt;6. &lt;b&gt;Indicador Externo:&lt;/b&gt; Suplemento.calcularPrecioCLP() usa IndicadorDolar vía dependencia punteada &amp;lt;&amp;lt;use&amp;gt;&amp;gt;." vertex="1">
          <mxGeometry height="170" width="560" x="1100" y="100" as="geometry" />
        </mxCell>

        <mxCell id="box_valor_agregado" parent="1" style="text;html=1;align=left;verticalAlign=top;fontStyle=0;fontColor=#7D6608;fontSize=11;strokeColor=#F1C40F;fillColor=#FEFDE8;rounded=1;arcSize=6;spacingLeft=10;spacingTop=8;spacingRight=10;spacingBottom=8;whiteSpace=wrap;" value="&lt;b&gt;🚀 EL VALOR AGREGADO (EL '20 DE 10')&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Circuito Transaccional de Ventas:&lt;/b&gt; Suplemento no queda 'en el aire': se integra con Venta y DetalleVenta bajo control del Recepcionista.&lt;br&gt;• &lt;b&gt;Control de Inventario:&lt;/b&gt; Suplemento cuenta con stock, stockMinimo, hayStock() y descontarStock() garantizando trazabilidad física.&lt;br&gt;• &lt;b&gt;Seguridad y RBAC:&lt;/b&gt; Trabajador centraliza passHash y autenticación, permitiendo perfiles estrictos en la GUI PySide6." vertex="1">
